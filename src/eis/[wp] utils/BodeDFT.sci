function y = mag_db(z)
    y = 20 * log10(abs(z)); // mag in dB
endfunction

function y = phase_deg(z)
    y = atan(imag(z), real(z)) * (180/%pi); // phase (atan2 style)
endfunction

mag1 = mag_db(z1);
mag2 = mag_db(z2);
mag3 = mag_db(z3);

ph1 = phase_deg(z1);
ph2 = phase_deg(z2);
ph3 = phase_deg(z3);

// --- Plot
scf(0); clf;

// Mag (dB)
subplot(2,1,1);
plot(freqs, mag1, '-o', freqs, mag2, '-s', freqs, mag3, '-^');
a = gca();
a.log_flags = "lnn"; // escalw log
xtitle("Bode - Magnitude (dB)", "Frequence (Hz)", "Magnitude (dB)");
legend(["0uF","1uF","100uF"], "in_upper_left");
xgrid();

// Phase (degrees)
subplot(2,1,2);
plot(freqs, ph1, '-o', freqs, ph2, '-s', freqs, ph3, '-^');
a = gca();
a.log_flags = "lnn"; // escale log
xtitle("", "Frequence (Hz)", "Phase (degrees)");
legend(["0uF","1uF","100uF"], "in_upper_left");
xgrid();

// --- Plot Nyquist ao lado direito (em uma nova figura, que pode ser posicionada ao lado)
scf(1); clf;
plot2d(real(z1), -imag(z1), style=2); // linha conectando os pontos
plot2d(real(z1), -imag(z1), style=-1); // pontos
a = gca();
xtitle("Nyquist Plot (cap not used)", "Real Part", " - Imaginary Part");
legend(["Curve"], "in_upper_right");
xgrid();

scf(2); clf;
plot2d(real(z2), -imag(z2), style=2); // linha conectando os pontos
plot2d(real(z2), -imag(z2), style=-1); // pontos
a = gca();
xtitle("Nyquist Plot (Ctia = 1uF)", "Real Part", " - Imaginary Part");
legend(["Curve"], "in_upper_right");
xgrid();

scf(3); clf;
plot2d(real(z3), -imag(z3), style=2); // linha conectando os pontos
plot2d(real(z3), -imag(z3), style=-1); // pontos
a = gca();
xtitle("Nyquist Plot (Ctia = 100uF)", "Real Part", " - Imaginary Part");
legend(["Curve"], "in_upper_right");
xgrid();
